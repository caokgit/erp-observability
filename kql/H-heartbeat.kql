// H heartbeat (docs/specs/round-1.md#signals): a bin with no heartbeat row from the SQL job of TargetEnv. The job
// writes one only when the whole run succeeded (job/sql_job.py). Empty bins come from range(), so the rule also
// fires when the table has no row at all.
// Parameters: TargetEnv, Start, End, BinSize.
let Beats = OdooHeartbeat_CL
    | where TimeGenerated between (Start .. End) and Env == TargetEnv
    | summarize Heartbeats = count(), LastBeat = max(TimeGenerated) by Bin = bin_at(TimeGenerated, BinSize, Start);
range Bin from Start to End - 1s step BinSize
| join kind=leftouter Beats on Bin
| where coalesce(Heartbeats, 0) == 0
| project Bin, Heartbeats = 0
